# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (sql.daruntech.cloud)
DB_HOST=sql.daruntech.cloud
DB_PORT=3306
DB_NAME=darun_for_indore
MASTER_DB_NAME=darun_for_indore
DB_USER=darun_for_indore_user
DB_PASSWORD=darun_for_indore_user

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client URL
CLIENT_URL=http://localhost:5173

# MinIO Object Storage Configuration (Replaces Cloudinary)
MINIO_ENDPOINT=storage.console.daruntech.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ROOT_USER=daruntech.pvt.ltd.com
MINIO_ROOT_PASSWORD=Darun@storage
MINIO_BUCKET=indoor
MINIO_BROWSER_REDIRECT_URL=https://storage.console.daruntech.com
MINIO_PUBLIC_URL=https://storage.console.daruntech.com/indoor

# Gmail SMTP Email Configuration (Super Admin, Venue Admin & Staff Login Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Indoor Management System" <no-reply@daruntech.com>
