{
  "name": "indoor-sports-booking-server",
  "version": "1.0.0",
  "description": "Backend server for Indoor Sports Booking System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "nodemon server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seeder.js",
    "test:api": "node utils/test_api.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "migrate": "node migrations/run.js",
    "migrate:backfill": "node scripts/backfill-business-data.js",
    "migrate:verify-backfill": "node scripts/verify-backfill.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.5",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.0.0"
  }
}
